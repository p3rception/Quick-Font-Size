{
  "name": "quick-font-size",
  "displayName": "Quick Font Size",
  "description": "Cmd/Ctrl +/- changes the font size of the focused area (editor, chat, terminal, debug console, Markdown preview) instead of zooming the whole window.",
  "version": "1.0.0",
  "publisher": "pergelidis",
  "author": "Dimitris Pergelidis",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/p3rception/Quick-Font-Size.git"
  },
  "homepage": "https://github.com/p3rception/Quick-Font-Size#readme",
  "bugs": {
    "url": "https://github.com/p3rception/Quick-Font-Size/issues"
  },
  "icon": "images/icon.png",
  "categories": [
    "Keymaps",
    "Other"
  ],
  "keywords": [
    "font size",
    "zoom",
    "status bar",
    "chat",
    "terminal",
    "claude",
    "copilot",
    "markdown",
    "debug console"
  ],
  "engines": {
    "vscode": "^1.93.0"
  },
  "extensionKind": [
    "ui"
  ],
  "capabilities": {
    "untrustedWorkspaces": {
      "supported": true
    },
    "virtualWorkspaces": true
  },
  "activationEvents": [
    "onStartupFinished"
  ],
  "main": "extension.js",
  "files": [
    "extension.js",
    "images/icon.png",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "contributes": {
    "commands": [
      {
        "command": "quickFontSize.increase",
        "title": "Increase",
        "category": "Font Size"
      },
      {
        "command": "quickFontSize.decrease",
        "title": "Decrease",
        "category": "Font Size"
      },
      {
        "command": "quickFontSize.reset",
        "title": "Reset to Default",
        "category": "Font Size"
      },
      {
        "command": "quickFontSize.chooseArea",
        "title": "Choose Status Bar Area",
        "category": "Font Size"
      }
    ],
    "configuration": {
      "title": "Quick Font Size",
      "properties": {
        "quickFontSize.step": {
          "type": "number",
          "default": 1,
          "exclusiveMinimum": 0,
          "markdownDescription": "Amount each `Increase` or `Decrease` changes the font size by."
        },
        "quickFontSize.minimum": {
          "type": "number",
          "default": 6,
          "minimum": 1,
          "markdownDescription": "Smallest font size `Decrease` goes to."
        },
        "quickFontSize.maximum": {
          "type": "number",
          "default": 100,
          "minimum": 1,
          "markdownDescription": "Largest font size `Increase` goes to."
        }
      }
    },
    "keybindings": [
      {
        "key": "ctrl+=",
        "mac": "cmd+=",
        "command": "quickFontSize.increase",
        "args": {
          "area": "editor"
        }
      },
      {
        "key": "ctrl+shift+=",
        "mac": "cmd+shift+=",
        "command": "quickFontSize.increase",
        "args": {
          "area": "editor"
        }
      },
      {
        "key": "ctrl+numpad_add",
        "mac": "cmd+numpad_add",
        "command": "quickFontSize.increase",
        "args": {
          "area": "editor"
        }
      },
      {
        "key": "ctrl+-",
        "mac": "cmd+-",
        "command": "quickFontSize.decrease",
        "args": {
          "area": "editor"
        }
      },
      {
        "key": "ctrl+shift+-",
        "mac": "cmd+shift+-",
        "command": "quickFontSize.decrease",
        "args": {
          "area": "editor"
        }
      },
      {
        "key": "ctrl+numpad_subtract",
        "mac": "cmd+numpad_subtract",
        "command": "quickFontSize.decrease",
        "args": {
          "area": "editor"
        }
      },
      {
        "key": "ctrl+0",
        "mac": "cmd+0",
        "command": "quickFontSize.reset",
        "args": {
          "area": "editor"
        }
      },
      {
        "key": "ctrl+numpad0",
        "mac": "cmd+numpad0",
        "command": "quickFontSize.reset",
        "args": {
          "area": "editor"
        }
      },
      {
        "key": "ctrl+=",
        "mac": "cmd+=",
        "command": "quickFontSize.increase",
        "args": {
          "area": "chat"
        },
        "when": "inChat || focusedView == 'claudeVSCodeSidebar' || focusedView == 'claudeVSCodeSidebarSecondary' || activeWebviewPanelId == 'claudeVSCodePanel'"
      },
      {
        "key": "ctrl+shift+=",
        "mac": "cmd+shift+=",
        "command": "quickFontSize.increase",
        "args": {
          "area": "chat"
        },
        "when": "inChat || focusedView == 'claudeVSCodeSidebar' || focusedView == 'claudeVSCodeSidebarSecondary' || activeWebviewPanelId == 'claudeVSCodePanel'"
      },
      {
        "key": "ctrl+numpad_add",
        "mac": "cmd+numpad_add",
        "command": "quickFontSize.increase",
        "args": {
          "area": "chat"
        },
        "when": "inChat || focusedView == 'claudeVSCodeSidebar' || focusedView == 'claudeVSCodeSidebarSecondary' || activeWebviewPanelId == 'claudeVSCodePanel'"
      },
      {
        "key": "ctrl+-",
        "mac": "cmd+-",
        "command": "quickFontSize.decrease",
        "args": {
          "area": "chat"
        },
        "when": "inChat || focusedView == 'claudeVSCodeSidebar' || focusedView == 'claudeVSCodeSidebarSecondary' || activeWebviewPanelId == 'claudeVSCodePanel'"
      },
      {
        "key": "ctrl+shift+-",
        "mac": "cmd+shift+-",
        "command": "quickFontSize.decrease",
        "args": {
          "area": "chat"
        },
        "when": "inChat || focusedView == 'claudeVSCodeSidebar' || focusedView == 'claudeVSCodeSidebarSecondary' || activeWebviewPanelId == 'claudeVSCodePanel'"
      },
      {
        "key": "ctrl+numpad_subtract",
        "mac": "cmd+numpad_subtract",
        "command": "quickFontSize.decrease",
        "args": {
          "area": "chat"
        },
        "when": "inChat || focusedView == 'claudeVSCodeSidebar' || focusedView == 'claudeVSCodeSidebarSecondary' || activeWebviewPanelId == 'claudeVSCodePanel'"
      },
      {
        "key": "ctrl+0",
        "mac": "cmd+0",
        "command": "quickFontSize.reset",
        "args": {
          "area": "chat"
        },
        "when": "inChat || focusedView == 'claudeVSCodeSidebar' || focusedView == 'claudeVSCodeSidebarSecondary' || activeWebviewPanelId == 'claudeVSCodePanel'"
      },
      {
        "key": "ctrl+numpad0",
        "mac": "cmd+numpad0",
        "command": "quickFontSize.reset",
        "args": {
          "area": "chat"
        },
        "when": "inChat || focusedView == 'claudeVSCodeSidebar' || focusedView == 'claudeVSCodeSidebarSecondary' || activeWebviewPanelId == 'claudeVSCodePanel'"
      },
      {
        "key": "ctrl+=",
        "mac": "cmd+=",
        "command": "quickFontSize.increase",
        "args": {
          "area": "markdown.preview"
        },
        "when": "activeWebviewPanelId == 'markdown.preview'"
      },
      {
        "key": "ctrl+shift+=",
        "mac": "cmd+shift+=",
        "command": "quickFontSize.increase",
        "args": {
          "area": "markdown.preview"
        },
        "when": "activeWebviewPanelId == 'markdown.preview'"
      },
      {
        "key": "ctrl+numpad_add",
        "mac": "cmd+numpad_add",
        "command": "quickFontSize.increase",
        "args": {
          "area": "markdown.preview"
        },
        "when": "activeWebviewPanelId == 'markdown.preview'"
      },
      {
        "key": "ctrl+-",
        "mac": "cmd+-",
        "command": "quickFontSize.decrease",
        "args": {
          "area": "markdown.preview"
        },
        "when": "activeWebviewPanelId == 'markdown.preview'"
      },
      {
        "key": "ctrl+shift+-",
        "mac": "cmd+shift+-",
        "command": "quickFontSize.decrease",
        "args": {
          "area": "markdown.preview"
        },
        "when": "activeWebviewPanelId == 'markdown.preview'"
      },
      {
        "key": "ctrl+numpad_subtract",
        "mac": "cmd+numpad_subtract",
        "command": "quickFontSize.decrease",
        "args": {
          "area": "markdown.preview"
        },
        "when": "activeWebviewPanelId == 'markdown.preview'"
      },
      {
        "key": "ctrl+0",
        "mac": "cmd+0",
        "command": "quickFontSize.reset",
        "args": {
          "area": "markdown.preview"
        },
        "when": "activeWebviewPanelId == 'markdown.preview'"
      },
      {
        "key": "ctrl+numpad0",
        "mac": "cmd+numpad0",
        "command": "quickFontSize.reset",
        "args": {
          "area": "markdown.preview"
        },
        "when": "activeWebviewPanelId == 'markdown.preview'"
      },
      {
        "key": "ctrl+=",
        "mac": "cmd+=",
        "command": "quickFontSize.increase",
        "args": {
          "area": "debug.console"
        },
        "when": "inDebugRepl"
      },
      {
        "key": "ctrl+shift+=",
        "mac": "cmd+shift+=",
        "command": "quickFontSize.increase",
        "args": {
          "area": "debug.console"
        },
        "when": "inDebugRepl"
      },
      {
        "key": "ctrl+numpad_add",
        "mac": "cmd+numpad_add",
        "command": "quickFontSize.increase",
        "args": {
          "area": "debug.console"
        },
        "when": "inDebugRepl"
      },
      {
        "key": "ctrl+-",
        "mac": "cmd+-",
        "command": "quickFontSize.decrease",
        "args": {
          "area": "debug.console"
        },
        "when": "inDebugRepl"
      },
      {
        "key": "ctrl+shift+-",
        "mac": "cmd+shift+-",
        "command": "quickFontSize.decrease",
        "args": {
          "area": "debug.console"
        },
        "when": "inDebugRepl"
      },
      {
        "key": "ctrl+numpad_subtract",
        "mac": "cmd+numpad_subtract",
        "command": "quickFontSize.decrease",
        "args": {
          "area": "debug.console"
        },
        "when": "inDebugRepl"
      },
      {
        "key": "ctrl+0",
        "mac": "cmd+0",
        "command": "quickFontSize.reset",
        "args": {
          "area": "debug.console"
        },
        "when": "inDebugRepl"
      },
      {
        "key": "ctrl+numpad0",
        "mac": "cmd+numpad0",
        "command": "quickFontSize.reset",
        "args": {
          "area": "debug.console"
        },
        "when": "inDebugRepl"
      },
      {
        "key": "ctrl+=",
        "mac": "cmd+=",
        "command": "quickFontSize.increase",
        "args": {
          "area": "terminal.integrated"
        },
        "when": "terminalFocus"
      },
      {
        "key": "ctrl+shift+=",
        "mac": "cmd+shift+=",
        "command": "quickFontSize.increase",
        "args": {
          "area": "terminal.integrated"
        },
        "when": "terminalFocus"
      },
      {
        "key": "ctrl+numpad_add",
        "mac": "cmd+numpad_add",
        "command": "quickFontSize.increase",
        "args": {
          "area": "terminal.integrated"
        },
        "when": "terminalFocus"
      },
      {
        "key": "ctrl+-",
        "mac": "cmd+-",
        "command": "quickFontSize.decrease",
        "args": {
          "area": "terminal.integrated"
        },
        "when": "terminalFocus"
      },
      {
        "key": "ctrl+shift+-",
        "mac": "cmd+shift+-",
        "command": "quickFontSize.decrease",
        "args": {
          "area": "terminal.integrated"
        },
        "when": "terminalFocus"
      },
      {
        "key": "ctrl+numpad_subtract",
        "mac": "cmd+numpad_subtract",
        "command": "quickFontSize.decrease",
        "args": {
          "area": "terminal.integrated"
        },
        "when": "terminalFocus"
      },
      {
        "key": "ctrl+0",
        "mac": "cmd+0",
        "command": "quickFontSize.reset",
        "args": {
          "area": "terminal.integrated"
        },
        "when": "terminalFocus"
      },
      {
        "key": "ctrl+numpad0",
        "mac": "cmd+numpad0",
        "command": "quickFontSize.reset",
        "args": {
          "area": "terminal.integrated"
        },
        "when": "terminalFocus"
      },
      {
        "key": "ctrl+alt+=",
        "win": "ctrl+shift+alt+=",
        "mac": "cmd+alt+=",
        "command": "quickFontSize.increase",
        "args": {
          "area": "*"
        }
      },
      {
        "key": "ctrl+alt+shift+=",
        "win": "ctrl+shift+alt+=",
        "mac": "cmd+alt+shift+=",
        "command": "quickFontSize.increase",
        "args": {
          "area": "*"
        }
      },
      {
        "key": "ctrl+alt+numpad_add",
        "mac": "cmd+alt+numpad_add",
        "command": "quickFontSize.increase",
        "args": {
          "area": "*"
        }
      },
      {
        "key": "ctrl+alt+-",
        "win": "ctrl+shift+alt+-",
        "mac": "cmd+alt+-",
        "command": "quickFontSize.decrease",
        "args": {
          "area": "*"
        }
      },
      {
        "key": "ctrl+alt+shift+-",
        "win": "ctrl+shift+alt+-",
        "mac": "cmd+alt+shift+-",
        "command": "quickFontSize.decrease",
        "args": {
          "area": "*"
        }
      },
      {
        "key": "ctrl+alt+numpad_subtract",
        "mac": "cmd+alt+numpad_subtract",
        "command": "quickFontSize.decrease",
        "args": {
          "area": "*"
        }
      },
      {
        "key": "ctrl+alt+0",
        "win": "ctrl+shift+alt+0",
        "mac": "cmd+alt+0",
        "command": "quickFontSize.reset",
        "args": {
          "area": "*"
        }
      },
      {
        "key": "ctrl+alt+numpad0",
        "mac": "cmd+alt+numpad0",
        "command": "quickFontSize.reset",
        "args": {
          "area": "*"
        }
      }
    ]
  }
}
